# Copy this file to .env and adjust as needed. .env is gitignored - never
# commit real secrets or PHI-adjacent config to the repo.

# Path to a local FFmpeg bin/ directory, only needed if ffmpeg is not
# already on your system PATH.
FFMPEG_PATH=

# Whisper model size: tiny | base | small | medium | large
WHISPER_MODEL=base

# Local Ollama model used for SOAP synthesis (must be `ollama pull`-ed first)
OLLAMA_MODEL=llama3.2

# Optional: path to a Vosk model folder, for the low-latency /ws/stream-asr endpoint
VOSK_MODEL_PATH=
